# AegisCPG -- eBPF LSM loader image.
#
# Author: Pratham Kapoor <prathamkapoor027@gmail.com>
# https://github.com/PrathamKapoor
#
# WHAT:  Clang, bpftool and the loader, for the one service that touches
#        /sys/fs/bpf.
# WHY:   This is the only image that needs a capability. It is built separately
#        and put behind a compose profile (`--profile kernel-lsm`) so an
#        operator who is not running a 5.7+ kernel with CONFIG_BPF_LSM does not
#        start it by accident and does not believe enforcement is active when it
#        is not.
# HOW:   Two stages. The first compiles `ebpf-probes/lsm_enforcer.bpf.c`, so the
#        object in the image is the object in the repository. Its struct layout
#        is cross-checked against the Rust decoder by `bpf_layout.rs`, which
#        runs in the ordinary test suite on every host.

# --- Stage 1: the Rust loader and the BPF object -----------------------------
FROM rust:1.82-bookworm AS builder

RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        clang \
        llvm \
        libssl-dev \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY crates/ ./crates/
RUN cargo build --release --locked -p aegis-ebpf-loader

WORKDIR /src
COPY ebpf-probes/ ./ebpf-probes/
# -mcpu=v3 matches the host the target deployment runs on; a mismatched cpu
# silently disables the atomics the BPF map uses.
RUN clang -O2 -g \
        -target bpf \
        -mcpu=v3 \
        -D__TARGET_ARCH_x86 \
        -c ebpf-probes/lsm_enforcer.bpf.c \
        -o /lsm_enforcer.bpf.o

# --- Stage 2: runtime, no toolchain -----------------------------------------
FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        libbpf-dev \
        bpftool \
        libelf1 \
        zlib1g \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --system --uid 65534 --no-create-home --shell /usr/sbin/nologin aegis

COPY --from=builder /build/target/release/aegis-ebpf-loader /usr/local/bin/aegis-ebpf-loader
# The object is world-readable and the service runs read-only, so it is baked in
# rather than mounted from the host.
COPY --from=builder /lsm_enforcer.bpf.o /usr/local/share/aegis/lsm_enforcer.bpf.o

USER 65534:65534

ENTRYPOINT ["/usr/local/bin/aegis-ebpf-loader"]
CMD ["--help"]
