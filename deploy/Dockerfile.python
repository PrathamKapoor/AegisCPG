# AegisCPG -- Python control plane image.
#
# Author: Pratham Kapoor <prathamkapoor027@gmail.com>
# https://github.com/PrathamKapoor
#
# WHAT:  The FastAPI ML service plus the compiled Rust CLI it needs for corpus
#        extraction.
# WHY:   `aegis_ml.training_corpus` extracts its corpus by invoking the binary,
#        so the service image must contain it. Shipping one image rather than
#        two removes a version-skew class: a model trained against a different
#        extractor's output than the one serving it is a silent accuracy loss.
# HOW:   Wheels are installed into a virtual environment and the interpreter is
#        set to it, so the image runs unprivileged with no site-packages writes.

FROM python:3.12-slim-bookworm AS build

# The Rust CLI is cross-compiled here and copied in at the end.
RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        build-essential \
        clang \
        curl \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY ml-rag-engine/pyproject.toml ./
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"
# Every wheel has a win-free manylinux build, so this needs no compiler at run
# time. numpy, scipy, scikit-learn, onnx, onnxruntime, duckdb, fastapi, httpx.
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir \
        "numpy>=2.0" \
        "scipy>=1.13" \
        "scikit-learn>=1.5" \
        "onnx>=1.17" \
        "onnxruntime>=1.19" \
        "duckdb>=1.0" \
        "fastapi>=0.115" \
        "uvicorn[standard]>=0.32" \
        "pydantic>=2.9" \
        "httpx>=0.27" \
        "tree-sitter>=0.23" \
        "tree-sitter-python>=0.23" \
        "tree-sitter-javascript>=0.23" \
        "tree-sitter-typescript>=0.23" \
        "tree-sitter-rust>=0.23"

COPY ml-rag-engine/aegis_ml/ ./aegis_ml/
# Extracted at start rather than baked in: the model is a build output whose
# hash is reported by /health, and baking it would hide a retrain.
RUN mkdir -p /models \
    && python -c "import sys; sys.path.insert(0,'.'); \
from aegis_ml.gat_divergence import DivergenceModel; \
m = DivergenceModel(); m.train(); m.export_onnx()" \
    && mv models/aegis_divergence.onnx /models/aegis_divergence.onnx 2>/dev/null || true

FROM python:3.12-slim-bookworm AS runtime

RUN useradd --system --uid 65534 --no-create-home --shell /usr/sbin/nologin aegis

COPY --from=build /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# The trained graph. Read-only to the service; the cache volume is where a
# retrain writes.
COPY --from=build /models/aegis_divergence.onnx /usr/local/share/aegis/aegis_divergence.onnx
COPY --from=build /build/aegis_ml/ /opt/aegis_ml/

USER 65534:65534
WORKDIR /opt
EXPOSE 8077

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8077/health', timeout=3).status==200 else 1)"

CMD ["python", "-m", "aegis_ml.server"]
